var G_TIMER_MINUTOS = 10;

function timerToDate(pHoraCarrega) { // getTemporizador
  vHoraSplit = pHoraCarrega.split('-');

  vData = vHoraSplit[0].split('/');
  vHora = vHoraSplit[1].split(':');

  return new Date(vData[2], vData[1] - 1, vData[0], vHora[0], vHora[1], vHora[2]);
}


