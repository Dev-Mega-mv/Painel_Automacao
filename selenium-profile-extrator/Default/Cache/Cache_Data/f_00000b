/* funções utilizadas para abrir e fechar form dialog modal */
function fwAbrirDialog(region) {
  $('#' + region).parent().css('width', 'auto');

  v_dtop = $(document).height() / 2;
  v_dleft = $(document).width() / 2;

  v_dheight = $('#' + region).parent().height();
  v_dwidth = $('#' + region).parent().width();

  if (v_dheight < 150) {
    v_dheight = 150;
    $('#' + region).parent().css('height', v_dheight);
  }

  if (v_dwidth < 450) {
    v_dwidth = 450;
    $('#' + region).parent().css('width', v_dwidth);
  }

  v_dtop -= (v_dheight / 2);
  v_dleft -= (v_dwidth / 2);

  $('#' + region).parent().css('top', v_dtop);
  $('#' + region).parent().css('left', v_dleft);

  $('#' + region + '_CONTENT').css('height', v_dheight - 46);

  $('#modalBackground').show();
  $('#modalBackground').css('z-index', '99999990');

  $('#' + region).parent().show();
  $('#' + region).parent().css('z-index', '99999991');
}

function fwFecharDialog(region) {
  $('#' + region).parent().hide();
  $('#modalBackground').hide();
}

/* funcao utilizadas para abrir form dialog modal por url*/
function fwAbrirDialogUrl(pUrlDialog, pWidth, pHeight, pTitle) {
  /* Trigger JQuery UI dialog */
  var horizontalPadding = 30;
  var verticalPadding = 30;
  var dialog = $('<iframe id="modalDialog" src="' + pUrlDialog + '" frameborder="no" />').dialog({
    title: pTitle,
    autoOpen: true,
    width: pWidth,
    height: pHeight,
    modal: true,
    draggable: true,
    resizable: true,
    close: function (event, ui) { },
    overlay: {
      opacity: 0.2,
      background: 'black'
    }
  });

  dialog.width(pWidth).height(pHeight);

  // Posiciona Dialog
  v_dtop = $(document).height() / 2;
  v_dleft = $(document).width() / 2;

  v_dheight = dialog.parent().height();
  v_dwidth = dialog.parent().width();

  v_dtop -= (v_dheight / 2);
  v_dleft -= (v_dwidth / 2);

  dialog.parent().css('top', v_dtop);
  dialog.parent().css('left', v_dleft);

  $('.ui-widget-overlay.ui-front').css('z-index', '99999990');

  dialog.parent().css('z-index', '99999991');

  return dialog;
}

