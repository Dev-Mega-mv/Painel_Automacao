/**
 * Função que limita digitacao de caracteres em textarea (considerando tamanho das quebras de linha)
 *
 * Parâmetros:
 *    item:   item textarea cujo tamanho deve ser limitado.
 *
 * Analista:
 *    14/10/2016 - Tiago Arruda     - 157321 - Implementação
      05/04/2018 - Felipe D. Santos - 169197 - Copiado para o FwCard
**/
function fwLimiteTxArea(item) {

  var tamMaximo = $('#' + $(item).attr('id') + '_CHAR_COUNT>span:nth(1)').text();

  item.onkeypress = function (e) {
    //var tamMaximo = item.getAttribute('maxlength');
    var strPrevista = item.value + String.fromCharCode(e.which);
    var tamPrevisto = strPrevista.replace(/\r(?!\n)|\n(?!\r)/g, '\n').length;

    var key = e.keyCode || e.charCode;
    /* se != DEL e BACKSPACE, e tam. maximo campo < tam. minimo, retorna false */
    return !(!(key == 8 || (key == 46 && String.fromCharCode(e.which) != '.') || (parseInt(key, 10) > 36 && parseInt(key, 10) < 41)) && parseInt(tamMaximo, 10) < parseInt(tamPrevisto, 10));
  };

  item.onpaste = function (e) {
    var pastedText = undefined;
    if (window.clipboardData && window.clipboardData.getData) {
      // IE
      pastedText = window.clipboardData.getData('Text');
    } else
      if (e.clipboardData && e.clipboardData.getData) {
        pastedText = e.clipboardData.getData('text/plain');
      }

    //var tamMaximo = item.getAttribute('maxlength');
    var strPrevista = item.value + pastedText;
    var tamPrevisto = strPrevista.replace(/\r(?!\n)|\n(?!\r)/g, '\n').length;

    return (parseInt(tamPrevisto, 10) <= parseInt(tamMaximo, 10));
  };
}

