function validarValor(pValor, pDecimal, pInteiro, pNegativo, pMascara) {
  var vDecimal = (pDecimal == null ? 2 : pDecimal);
  var vInteiro = (pInteiro == null ? 0 : pInteiro);
  var vNegativo = (pNegativo == null ? 0 : pNegativo);
  var vMascara = (pMascara == null ? 0 : pMascara);
  var vIntComMasc = '*';
  var vIntSemMasc = '*';
  var vPrecisao = '';
  var regExpComMasc;
  var regExpSemMasc;

  if (vDecimal > 0) {
    vPrecisao = '(,[0-9]{1,' + vDecimal + '})?';
  }

  if (vInteiro > 0) {
    vIntComMasc = '{0,' + (Math.floor(vInteiro / 3) - 1) + '}';
    vIntSemMasc = '{1,' + vInteiro + '}';
  }

  if (vNegativo == 0) {
    vNegativo = '(-)?';
  } else if (vNegativo == -1) {
    vNegativo = '-';
  } else {
    vNegativo = '';
  }

  switch (vMascara) {
    case 0:
      regExpComMasc = new RegExp('^' + vNegativo + '[0-9]{1,3}(\\.[0-9]{3})' + vIntComMasc + '?' + vPrecisao + '$');
      regExpSemMasc = new RegExp('^' + vNegativo + '[0-9]' + vIntSemMasc + vPrecisao + '$');
      return regExpComMasc.test(pValor) || regExpSemMasc.test(pValor);
    case 1:
      regExpSemMasc = new RegExp('^' + vNegativo + '[0-9]' + vIntSemMasc + vPrecisao + '$');
      return regExpSemMasc.test(pValor);
    case 2:
      regExpComMasc = new RegExp('^' + vNegativo + '[0-9]{1,3}(\\.[0-9]{3})' + vIntComMasc + '?' + vPrecisao + '$');
      return regExpComMasc.test(pValor);
    default:
      return false;
  }
};

