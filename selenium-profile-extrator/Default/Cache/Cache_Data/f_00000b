/* Função usada para formatar a data no evento OnKeyPress */
function mascara_data2(pthis, event) {
  chCode = ('charCode' in event) ? event.charCode : event.keyCode;
  v_tam = pthis.value;
  if (v_tam.length == 2 && chCode != '47') { pthis.value += '/'; }
  if (v_tam.length == 5 && chCode != '47') { pthis.value += '/'; }
}

/* Função usada para formatar mês e ano no evento OnKeyPress */
function mascara_mes_ano(pthis, event) {
  chCode = ('charCode' in event) ? event.charCode : event.keyCode;
  v_tam = pthis.value;
  if (v_tam.length == 2 && chCode != '47') { pthis.value += '/'; }
}


function retiraMascara(ObjCPF) {
    return ObjCPF.value.replace(/\D/g, '');
}

/* Função de validar mascara generica #61762 */
function mascarar_documento(pThis, pItem) {

  switch (document.getElementById(pItem).value) {
    case 'F':
      pThis.maxLength = 14;
      mascara_cpf(pThis);
      break;
    case 'J':
      pThis.maxLength = 18;
      mascara_cnpj(pThis);
      break;
    case 'E':
      pThis.maxLength = 15;
      mascara_cei(pThis);
      break;
    default:
      return;
  }

}

function mascararDocProposta(pThis, pItem) {

  switch (document.getElementById(pItem).value) {
    case 'F':
      pThis.maxLength = 14;
      mascara_cpf(pThis);
      break;
    case 'O':
      pThis.maxLength = 11;
      retiraMascara(pThis);
      break;
    default:
      return;
  }

}

