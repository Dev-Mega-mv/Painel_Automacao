function mascara_valor(pthis, event) {

  if (pthis.value === '') {
    return
  }

  chCode = ('charCode' in event) ? event.charCode : event.keyCode;

  var tmp = pthis.value;
  tmp = tmp.replace(/\D/g, '');

  while (tmp.charAt(0) == '0') {
    tmp = tmp.substr(1);
  }

  if (tmp.length < 3) {
    tmp = Array(4 - tmp.length).join('0') + tmp;
  }

  tmp = tmp.replace(/(\d{1})(\d{14})$/, '$1.$2');
  tmp = tmp.replace(/(\d{1})(\d{11})$/, '$1.$2');
  tmp = tmp.replace(/(\d{1})(\d{8})$/, '$1.$2');
  tmp = tmp.replace(/(\d{1})(\d{5})$/, '$1.$2');
  tmp = tmp.replace(/(\d{1})(\d{1,2})$/, '$1,$2');

  pthis.value = tmp;
}

function mascara_valor_4casas(pthis, event) {

  chCode = ('charCode' in event) ? event.charCode : event.keyCode;

  var tmp = pthis.value;
  tmp = tmp.replace(/\D/g, '');

  while (tmp.charAt(0) == '0') {
    tmp = tmp.substr(1);
  }

  if (tmp.length < 6) {
    tmp = Array(6 - tmp.length).join('0') + tmp;
  }

  tmp = tmp.replace(/(\d{1})(\d{17})$/, '$1.$2');
  tmp = tmp.replace(/(\d{1})(\d{13})$/, '$1.$2');
  tmp = tmp.replace(/(\d{1})(\d{10})$/, '$1.$2');
  tmp = tmp.replace(/(\d{1})(\d{7})$/, '$1.$2');
  tmp = tmp.replace(/(\d{1})(\d{1,4})$/, '$1,$2');

  pthis.value = tmp;
}
