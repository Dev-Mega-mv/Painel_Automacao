  if (pBotao == 'O') vBotao = Ext.MessageBox.OK;
  if (pBotao == 'OC') vBotao = Ext.MessageBox.OKCANCEL;
  if (vBotao == null) vBotao = Ext.MessageBox.YESNOCANCEL;

