/**
  Responsável por atualizar o relogio global, se necessário. deve ser chamado no load e ao exibir notificacao 
  Caso tempo não tenha sido atingido, retorna o tempo que falta (para atualizar setInterval)
  
  Teste (retorna tempo restante em segundos ate a proxima atualizacao): console.log(fAtualizaRelogioGlobal()/60);
  
**/

function fAtualizaRelogioGlobal(pTimerExistente) {
  var timer = $.trim(buscaTimerNotificacao());

  vDataHoraAtual = new Date();
  //console.log('Hora Atual: ' + vDataHoraAtual);

  if (timer != '') {
    pTimerExistente.existe = true;

    vHoraAlarme = timerToDate(timer);
    //console.log('Hora Alarme: ' + vHoraAlarme);

    if (vDataHoraAtual >= vHoraAlarme) {
      inicializaTemporizador(vDataHoraAtual);
      //console.log('Hora de atualizar temporizador !!');
      return 0; // Alerta deve ser imediato
    } else {
      return (vHoraAlarme - vDataHoraAtual) / 1000; // retorna tempo em segundos
    }
  } else {
    pTimerExistente = false;
    inicializaTemporizador(vDataHoraAtual);
    return G_TIMER_MINUTOS;
  }
}

