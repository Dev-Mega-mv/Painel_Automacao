    Ext.MessageBox.show({
      title: pTitulo,
      msg: pMsg,
      buttons: vBotao,
      fn: Retorno,
      animEl: pThis,
      icon: vIcone
    });

    function Retorno(btn) {
      if ((btn == 'ok' || btn == 'yes') && pBotao != 'O')
