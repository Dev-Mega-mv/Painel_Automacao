ul.aChartList{
  margin:0;
  list-style:none;
  padding:0;
  zoom:1;
}

ul.aChartList:before,ul.aChartList:after{
  content:"\0020";
  display:block;
  height:0;
  overflow:hidden;
}

ul.aChartList:after{
  clear:both;
}

ul.aChartList li{
  display:block;
  margin:16px;
}

ul.aChartList li big.aValue{
  display:block;
  text-align:center;
  padding:8px 0;
  color:#404040;
  text-shadow:0 0 10px rgba(255,255,255,0.95);
  border-bottom:1px solid #B0BDCC;
  border-radius:2px 2px 0 0;
  /*background-color:#e6eefa;*/
  background-color:#F0F0F0;
  background-size:100%;
  background-image:-webkit-gradient(linear,50% 0,50% 100%,color-stop(0%,#F0F0F0),color-stop(100%,#F0F0F0));
  background-image:-webkit-linear-gradient(#F0F0F0,#F0F0F0);
  background-image:-moz-linear-gradient(#F0F0F0,#F0F0F0);
  background-image:linear-gradient(#F0F0F0,#F0F0F0);
  position:relative;
}

ul.aChartList li big.aValue:after,ul.aChartList li big.aValue:before{
  top:100%;
  border:solid transparent;
  content:" ";
  height:0;
  width:0;
  position:absolute;
  pointer-events:none;
}

ul.aChartList li big.aValue:after{
  border-top-color:#F0F0F0;
  border-width:8px;
  left:50%;
  margin-left:-8px;
}

ul.aChartList li big.aValue:before{
  border-top-color:#B0BDCC;
  border-width:9px;
  left:50%;
  margin-left:-9px;
}

ul.aChartList li a{
  border:1px solid #B0BDCC;
  border-bottom-color:#8896A9;
  background-color:#F0F4FA;
  border-radius:3px;
  padding:0;
  display:block;
  text-decoration:none;
  -webkit-transition:box-shadow .1s;
  -moz-transition:box-shadow .1s;
  transition:box-shadow .1s;
}

