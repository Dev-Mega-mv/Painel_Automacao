function abreRelatorio() {


    if(pesqItem != 1) {
        if ($('#uNotificationMessage').is(':visible') || $('section.fwRegPesquisa').parent().closest('section').find('.a-IRR-noDataMsg-text, .nodatafound').length > 0 ){
            return $('#FILTRO .uRegionControl').click();   
        }
        if($('.a-IRR-container .a-IRR-content').length == 0 ) {
            return $('#FILTRO .uRegionControl').click();
        }   
    }

    if ($('#uNotificationMessage').is(':visible') || ($('section.fwRegPesquisa').parent().closest('section').find('.a-IRR-noDataMsg-text, .nodatafound').length > 0  && pesqItem != 0)){
       return $('#FILTRO .uRegionControl').click();   
    }
    if($('.a-IRR-container .a-IRR-content').length == 0 && pesqItem != 1) {
       return $('#FILTRO .uRegionControl').click();
    }
}

try {
    if($(`input[id*="P${pagina}_PESQ"]`).length > 0) {
        $(document).ready(async () => {
            if($('.a-IRR-reportView').is(':visible')) {
                abreRelatorio()
            } else {
                if($('.u-Processing').length == 0) {
                    spinner = apex.util.showSpinner();
                    isShowSpinner = true;
                }
                //await _waitForElement(`.a-IRR-reportView`);
                onElementAvailable(".a-IRR-reportView", (retorno) => {
                    if(!retorno) {
                        return;
                    }
                    abreRelatorio();
                    if(isShowSpinner) {
                        spinner.remove() 
                    } 
                });    
            }
        })
    }
} catch(e){
    console.log(e);
    $('.a-IRR-container .a-IRR-content').ready(() => {
        if($('.a-IRR-reportView').is(':visible')) {
            abreRelatorio()
        } 
    })
}


